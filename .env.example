# Copy to .env (gitignored). Defaults run fully offline.

# mock  -> canned responses + heuristic recommender, no network (default, safe demo path)
# bedrock -> Claude via Amazon Bedrock converse API (needs AWS creds in env / profile / IAM role)
DISPUTEDESK_LLM_PROVIDER=mock

# Bedrock (only read when provider=bedrock). Production target is ap-south-1 (data residency;
# matches infra/). A Bedrock API key is bound to the region it was issued in — if yours is
# us-east-1, set AWS_REGION=us-east-1 and a "us." inference-profile id instead.
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=apac.anthropic.claude-sonnet-4-5-20250929-v1:0
# e.g. for a us-east-1 key:  AWS_REGION=us-east-1  BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
# Auth — pick ONE. In ECS none of these are set: the task role provides credentials.
#   a) Bedrock API key (simplest for local dev; boto3 reads it automatically):
# AWS_BEARER_TOKEN_BEDROCK=
#   b) IAM user keys:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
#   c) named profile:
# AWS_PROFILE=disputedesk

# 1 -> hybrid BM25 + bge-small dense retrieval with RRF (needs requirements-dense.txt). 0 -> BM25 only.
DISPUTEDESK_DENSE_RETRIEVAL=0

# Reviewer identity stamped on every approval (replaced by SSO in production)
DISPUTEDESK_REVIEWER=analyst@example.com

# Optional Langfuse tracing on recommend / draft_response only
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
