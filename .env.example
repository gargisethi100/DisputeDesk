# Copy to .env (gitignored). Defaults run fully offline.

# mock  -> canned responses + heuristic recommender, no network (default, safe demo path)
# bedrock -> Claude via Amazon Bedrock converse API (needs AWS creds in env / profile / IAM role)
DISPUTEDESK_LLM_PROVIDER=mock

# Bedrock (only read when provider=bedrock). ap-south-1 keeps data in-region.
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=apac.anthropic.claude-sonnet-4-5-20250929-v1:0
# Optional: AWS_PROFILE=disputedesk  (or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY)

# 1 -> hybrid BM25 + bge-small dense retrieval with RRF (needs requirements-dense.txt). 0 -> BM25 only.
DISPUTEDESK_DENSE_RETRIEVAL=0

# Reviewer identity stamped on every approval (replaced by SSO in production)
DISPUTEDESK_REVIEWER=analyst@example.com

# Optional Langfuse tracing on recommend / draft_response only
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
